# Usuario y clave del panel de edición (los botones de editar solo aparecen al iniciar sesión)
ADMIN_USER=torneopdo
ADMIN_PASSWORD=cambiar-esta-clave

# Clave para firmar la sesión (aleatoria, mínimo 16 caracteres).
# Generá una con:  openssl rand -base64 32
SESSION_SECRET=

# (Opcional) Carpeta donde se guardan los datos editados y el flyer. Por defecto: ./data
# DATA_DIR=./data
